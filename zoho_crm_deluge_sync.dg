void schedule.sync_google_sheets_to_zoho_crm()
{
	totalImported = 0;
	totalSkipped = 0;
	totalProcessed = 0;
	totalInvalid = 0;

	uploadDate = zoho.currentdate.toString("yyyy-MM-dd");
	uploadTime = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss");

	genericTitles = "contact us,contact,home,about us,about,contact our office,privacy policy,help center,terms of service,terms & conditions,customer support,support,services,login,register,sign in,double whammy,overview,faq,faqs,get in touch,enquiry form,enquiries,referral form,locations,meet our team,our team";

	// ==============================================================================
	// 1. BULK SYNC SHEET 1: Web Leads (Code.gs -> Tab: Leads, gid=1144923842)
	// ==============================================================================
	webSheetId = "1CbW9pPLyEtyl8cBpjNDcOEuLLFrgK5LFF8xoPRSMbpw";
	webGid = "1144923842";

	webCsvUrl = "https://docs.google.com/spreadsheets/d/" + webSheetId + "/gviz/tq?tqx=out:csv&gid=" + webGid;
	try 
	{
		webResp = invokeurl
		[
			url :webCsvUrl
			type :GET
			detailed :true
		];
		webCsvText = webResp.get("responseText");
		if(webCsvText == null || webCsvText == "") { webCsvText = webResp.get("response_text"); }
		if(webCsvText == null || webCsvText == "") { webCsvText = "" + webResp.get("response"); }

		if(webCsvText != "" && webCsvText != null)
		{
			webRows = webCsvText.replaceAll("\r","").toList("\n");
			info "📦 [Web Leads] Fetched " + webRows.size() + " lines.";

			if(webRows.size() > 1)
			{
				isHeader = true;
				for each row in webRows
				{
					if(isHeader) { isHeader = false; continue; }
					if(row.trim() == "") { continue; }

					cols = row.replaceAll("\",\"", "###SPLIT###").toList("###SPLIT###");
					if(cols.size() >= 5)
					{
						totalProcessed = totalProcessed + 1;

						scrapDate = if(cols.size() > 0, cols.get(0).replaceAll("\"","").trim(), uploadDate);
						leadSource = if(cols.size() > 1, cols.get(1).replaceAll("\"","").trim(), "Google Search");
						rawCompany = if(cols.size() > 2, cols.get(2).replaceAll("\"","").trim(), "");
						rawEmail = if(cols.size() > 3, cols.get(3).replaceAll("\"","").trim().toLowerCase(), "");
						rawPhone = if(cols.size() > 4, cols.get(4).replaceAll("\"","").trim(), "");
						rawIndustry = if(cols.size() > 5, cols.get(5).replaceAll("\"","").trim(), "IT / Software");
						rawName = if(cols.size() > 6, cols.get(6).replaceAll("\"","").trim(), "Business Owner");
						rawNotes = if(cols.size() > 9, cols.get(9).replaceAll("\"","").trim(), "");

						// Email Validation
						cleanEmail = "";
						if(rawEmail.contains("@") && rawEmail.contains(".") && !rawEmail.contains("example.com") && !rawEmail.contains("domain.com") && !rawEmail.endsWith(".png") && !rawEmail.endsWith(".jpg") && !rawEmail.endsWith(".webp") && !rawEmail.startsWith("mailto:"))
						{
							cleanEmail = rawEmail.replaceAll("mailto:", "").replaceAll("<", "").replaceAll(">", "").trim();
						}

						// Phone Validation
						cleanPhone = rawPhone.replaceAll("[^0-9+ ]", "").trim();
						cleanMobile = "";
						if(cleanPhone.startsWith("04") || cleanPhone.startsWith("+614") || cleanPhone.startsWith("614"))
						{
							cleanMobile = cleanPhone;
							cleanPhone = "";
						}

						// MANDATORY: Must have Email AND (Phone or Mobile)
						if(cleanEmail == "" || (cleanPhone == "" && cleanMobile == ""))
						{
							totalInvalid = totalInvalid + 1;
							continue;
						}

						// Company Name Sanitization
						cleanCompany = rawCompany;
						if(cleanCompany == "" || genericTitles.contains(cleanCompany.toLowerCase()) || cleanCompany.length() < 2)
						{
							cleanCompany = "Australian Enterprise";
						}

						// Direct Insert to Zoho CRM (Zoho handles dedup internally)
						leadMap = Map();
						leadMap.put("Last_Name", if(rawName != "", rawName, "Decision Maker"));
						leadMap.put("Company", cleanCompany);
						if(cleanEmail != "") { leadMap.put("Email", cleanEmail); }
						if(cleanPhone != "") { leadMap.put("Phone", cleanPhone); }
						if(cleanMobile != "") { leadMap.put("Mobile", cleanMobile); }
						leadMap.put("Industry", if(rawIndustry != "", rawIndustry, "IT / Software"));
						leadMap.put("Lead_Source", leadSource);
						leadMap.put("Description", "Uploaded: " + uploadTime + " | Scraped Date: " + scrapDate + " | Notes: " + rawNotes);

						createRes = zoho.crm.createRecord("Leads", leadMap);
						totalImported = totalImported + 1;
					}
				}
			}
		}
	}
	catch (errCode) 
	{ 
		info "❌ Error Web Leads: " + errCode; 
	}

	// ==============================================================================
	// 2. BULK SYNC SHEET 2: Social Leads (SocialScraper.gs -> Tab: Social Leads, gid=1029677902)
	// ==============================================================================
	socialSheetId = "1P9LOyq4UKwVuc8ZFjg6cOlb2fwOci3nUV300E5J5Fgw";
	socialGid = "1029677902";

	socialCsvUrl = "https://docs.google.com/spreadsheets/d/" + socialSheetId + "/gviz/tq?tqx=out:csv&gid=" + socialGid;
	try 
	{
		socialResp = invokeurl
		[
			url :socialCsvUrl
			type :GET
			detailed :true
		];
		socialCsvText = socialResp.get("responseText");
		if(socialCsvText == null || socialCsvText == "") { socialCsvText = socialResp.get("response_text"); }
		if(socialCsvText == null || socialCsvText == "") { socialCsvText = "" + socialResp.get("response"); }

		if(socialCsvText != "" && socialCsvText != null)
		{
			socialRows = socialCsvText.replaceAll("\r","").toList("\n");
			info "📦 [Social Leads] Fetched " + socialRows.size() + " lines.";

			if(socialRows.size() > 1)
			{
				isSHeader = true;
				for each sRow in socialRows
				{
					if(isSHeader) { isSHeader = false; continue; }
					if(sRow.trim() == "") { continue; }

					sCols = sRow.replaceAll("\",\"", "###SPLIT###").toList("###SPLIT###");
					if(sCols.size() >= 5)
					{
						totalProcessed = totalProcessed + 1;

						sDate = if(sCols.size() > 0, sCols.get(0).replaceAll("\"","").trim(), uploadDate);
						sPlatform = if(sCols.size() > 1, sCols.get(1).replaceAll("\"","").trim(), "LinkedIn");
						sRawCompany = if(sCols.size() > 2, sCols.get(2).replaceAll("\"","").trim(), "");
						sRawEmail = if(sCols.size() > 3, sCols.get(3).replaceAll("\"","").trim().toLowerCase(), "");
						sRawPhone = if(sCols.size() > 4, sCols.get(4).replaceAll("\"","").trim(), "");
						sIndustry = if(sCols.size() > 5, sCols.get(5).replaceAll("\"","").trim(), "IT / Software");
						sName = if(sCols.size() > 6, sCols.get(6).replaceAll("\"","").trim(), "Founder / Executive");
						sNotes = if(sCols.size() > 9, sCols.get(9).replaceAll("\"","").trim(), "");

						// Email Validation
						sCleanEmail = "";
						if(sRawEmail.contains("@") && sRawEmail.contains(".") && !sRawEmail.contains("example.com") && !sRawEmail.endsWith(".png") && !sRawEmail.endsWith(".jpg"))
						{
							sCleanEmail = sRawEmail.replaceAll("mailto:", "").replaceAll("<", "").replaceAll(">", "").trim();
						}

						// Phone Validation
						sCleanPhone = sRawPhone.replaceAll("[^0-9+ ]", "").trim();
						sCleanMobile = "";
						if(sCleanPhone.startsWith("04") || sCleanPhone.startsWith("+614") || sCleanPhone.startsWith("614"))
						{
							sCleanMobile = sCleanPhone;
							sCleanPhone = "";
						}

						// MANDATORY: Must have Email AND (Phone or Mobile)
						if(sCleanEmail == "" || (sCleanPhone == "" && sCleanMobile == ""))
						{
							totalInvalid = totalInvalid + 1;
							continue;
						}

						sCleanCompany = sRawCompany;
						if(sCleanCompany == "" || genericTitles.contains(sCleanCompany.toLowerCase()))
						{
							sCleanCompany = "Australian Enterprise";
						}

						// Insert to Zoho
						sLeadMap = Map();
						sLeadMap.put("Last_Name", if(sName != "", sName, "Executive"));
						sLeadMap.put("Company", sCleanCompany);
						if(sCleanEmail != "") { sLeadMap.put("Email", sCleanEmail); }
						if(sCleanPhone != "") { sLeadMap.put("Phone", sCleanPhone); }
						if(sCleanMobile != "") { sLeadMap.put("Mobile", sCleanMobile); }
						sLeadMap.put("Industry", sIndustry);
						sLeadMap.put("Lead_Source", sPlatform);
						sLeadMap.put("Description", "Social Lead via " + sPlatform + " | Scraped: " + sDate + " | Notes: " + sNotes);

						sCreateRes = zoho.crm.createRecord("Leads", sLeadMap);
						totalImported = totalImported + 1;
					}
				}
			}
		}
	}
	catch (errCode) 
	{ 
		info "❌ Error Social Leads: " + errCode; 
	}

	// ==============================================================================
	// 3. BULK SYNC SHEET 3: Multi-Tab Scraper Sheet (1QY8hbycY-gdOWRch52SKoUS975U-t3EgZ0JrtdhPCoM)
	// Covers 13 Tabs: Facebook, Freelancer, Upwork, LinkedIn, Instagram, Threads, YellowPages,
	// ABR Register, Yelp, Bing Directory, Expert360, 99acres, Odoo ERP
	// ==============================================================================
	multiSheetId = "1QY8hbycY-gdOWRch52SKoUS975U-t3EgZ0JrtdhPCoM";
	multiGids = {"0", "835700405", "597011379", "93563620", "1348388489", "511648997", "91912505", "455374992", "1616379665", "2070637993", "621089222", "596969109", "1197306578"};

	for each mGid in multiGids
	{
		mCsvUrl = "https://docs.google.com/spreadsheets/d/" + multiSheetId + "/gviz/tq?tqx=out:csv&gid=" + mGid;

		try
		{
			mResp = invokeurl
			[
				url :mCsvUrl
				type :GET
				detailed :true
			];
			mCsvText = mResp.get("responseText");
			if(mCsvText == null || mCsvText == "") { mCsvText = mResp.get("response_text"); }
			if(mCsvText == null || mCsvText == "") { mCsvText = "" + mResp.get("response"); }

			if(mCsvText != "" && mCsvText != null)
			{
				mRows = mCsvText.replaceAll("\r","").toList("\n");
				info "📦 [Multi-Tab Sheet GID " + mGid + "] Fetched " + mRows.size() + " lines.";

				if(mRows.size() > 1)
				{
					isMHeader = true;
					for each mRow in mRows
					{
						if(isMHeader) { isMHeader = false; continue; }
						if(mRow.trim() == "") { continue; }

						mCols = mRow.replaceAll("\",\"", "###SPLIT###").toList("###SPLIT###");
						if(mCols.size() >= 10)
						{
							totalProcessed = totalProcessed + 1;

							// 26-column schema mapping
							mDate = if(mCols.size() > 0, mCols.get(0).replaceAll("\"","").trim(), uploadDate);
							mSource = if(mCols.size() > 1, mCols.get(1).replaceAll("\"","").trim(), "Multi-Tab Scraper");
							mCompany = if(mCols.size() > 2, mCols.get(2).replaceAll("\"","").trim(), "");
							mName = if(mCols.size() > 7, mCols.get(7).replaceAll("\"","").trim(), "");
							if(mName == "" && mCols.size() > 5) { mName = mCols.get(5).replaceAll("\"","").trim() + " " + mCols.get(6).replaceAll("\"","").trim(); }
							mEmailRaw = if(mCols.size() > 9, mCols.get(9).replaceAll("\"","").trim().toLowerCase(), "");
							mPhoneRaw = if(mCols.size() > 10, mCols.get(10).replaceAll("\"","").trim(), "");
							mMobileRaw = if(mCols.size() > 11, mCols.get(11).replaceAll("\"","").trim(), "");
							mIndustry = if(mCols.size() > 12, mCols.get(12).replaceAll("\"","").trim(), "IT / Software");
							mNotes = if(mCols.size() > 22, mCols.get(22).replaceAll("\"","").trim(), "");

							// Email Validation
							mCleanEmail = "";
							if(mEmailRaw.contains("@") && mEmailRaw.contains(".") && !mEmailRaw.contains("example.com") && !mEmailRaw.endsWith(".png") && !mEmailRaw.endsWith(".jpg"))
							{
								mCleanEmail = mEmailRaw.replaceAll("mailto:", "").replaceAll("<", "").replaceAll(">", "").trim();
							}

							// Phone & Mobile Cleaning
							mCleanPhone = mPhoneRaw.replaceAll("[^0-9+ ]", "").trim();
							mCleanMobile = mMobileRaw.replaceAll("[^0-9+ ]", "").trim();

							if(mCleanPhone.startsWith("04") || mCleanPhone.startsWith("+614") || mCleanPhone.startsWith("614"))
							{
								if(mCleanMobile == "") { mCleanMobile = mCleanPhone; }
								mCleanPhone = "";
							}

							// MANDATORY: Must have Email AND (Phone or Mobile)
							if(mCleanEmail == "" || (mCleanPhone == "" && mCleanMobile == ""))
							{
								totalInvalid = totalInvalid + 1;
								continue;
							}

							mCleanCompany = mCompany;
							if(mCleanCompany == "" || genericTitles.contains(mCleanCompany.toLowerCase()))
							{
								mCleanCompany = "Australian Enterprise";
							}

							// Insert directly to Zoho CRM (Zoho automatically handles deduplication based on unique Email/Phone rules)
							mLeadMap = Map();
							mLeadMap.put("Last_Name", if(mName != "", mName, "Executive"));
							mLeadMap.put("Company", mCleanCompany);
							if(mCleanEmail != "") { mLeadMap.put("Email", mCleanEmail); }
							if(mCleanPhone != "") { mLeadMap.put("Phone", mCleanPhone); }
							if(mCleanMobile != "") { mLeadMap.put("Mobile", mCleanMobile); }
							mLeadMap.put("Industry", mIndustry);
							mLeadMap.put("Lead_Source", mSource);
							mLeadMap.put("Description", "Multi-Tab Lead via " + mSource + " | Scraped: " + mDate + " | Notes: " + mNotes);

							mCreateRes = zoho.crm.createRecord("Leads", mLeadMap);
							totalImported = totalImported + 1;
						}
					}
				}
			}
		}
		catch (errCode)
		{
			info "❌ Error Multi-Tab Sheet GID " + mGid + ": " + errCode;
		}
	}

	info "=======================================================";
	info "🎉 ZOHO CRM DELUGE SYNC COMPLETE SUMMARY:";
	info "  - Total Records Processed : " + totalProcessed;
	info "  - Fresh Leads Uploaded    : " + totalImported;
	info "  - Duplicates Skipped      : " + totalSkipped;
	info "  - Invalid Contacts Skipped: " + totalInvalid;
	info "=======================================================";
}
