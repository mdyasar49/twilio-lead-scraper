void schedule.sync_google_sheets_to_zoho_crm()
{
	totalImported = 0;
	totalSkipped = 0;
	totalProcessed = 0;
	totalInvalid = 0;

	uploadDate = zoho.currentdate.toString("yyyy-MM-dd");
	uploadTime = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss");

	genericTitles = "contact us,contact,home,about us,about,contact our office,privacy policy,help center,terms of service,terms & conditions,customer support,support,services,login,register,sign in,double whammy,overview,faq,faqs,get in touch,enquiry form,enquiries,referral form,locations,meet our team,our team";

	// Master Target Configuration List: {id, gid, label, type}
	targets = List();

	// 1. Web Leads Sheet (1CbW9pPLyEtyl8cBpjNDcOEuLLFrgK5LFF8xoPRSMbpw)
	targets.add({"id": "1CbW9pPLyEtyl8cBpjNDcOEuLLFrgK5LFF8xoPRSMbpw", "gid": "1144923842", "label": "Web Leads", "type": "STANDARD_10"});

	// 2. Social Leads Sheet (1P9LOyq4UKwVuc8ZFjg6cOlb2fwOci3nUV300E5J5Fgw)
	targets.add({"id": "1P9LOyq4UKwVuc8ZFjg6cOlb2fwOci3nUV300E5J5Fgw", "gid": "1029677902", "label": "Social Leads", "type": "STANDARD_10"});

	// 3. Multi-Tab Scraper Sheet (1QY8hbycY-gdOWRch52SKoUS975U-t3EgZ0JrtdhPCoM) - 13 Tabs
	multiGids = {"0", "835700405", "597011379", "93563620", "1348388489", "511648997", "91912505", "455374992", "1616379665", "2070637993", "621089222", "596969109", "1197306578"};
	for each mGid in multiGids
	{
		targets.add({"id": "1QY8hbycY-gdOWRch52SKoUS975U-t3EgZ0JrtdhPCoM", "gid": mGid, "label": "Multi-Tab GID " + mGid, "type": "EXTENDED_28"});
	}

	// 4. Odoo ERP Leads Sheet (1iIcE_TI17N2hgva99ylF_RPyUZtllZHQu-SOUprSpB4) - 3 Tabs
	odooGids = {"1537325223", "401758669", "771759972"};
	for each oGid in odooGids
	{
		targets.add({"id": "1iIcE_TI17N2hgva99ylF_RPyUZtllZHQu-SOUprSpB4", "gid": oGid, "label": "Odoo ERP GID " + oGid, "type": "ODOO_ZOHO_21"});
	}

	// 5. Zoho Ecosystem Leads Sheet (1CPAernDPLSFJSebo5hFNQWsazLmbLbCS9TY0Kfa22SE) - 3 Tabs
	zohoGids = {"1736864648", "1675502893", "1375363359"};
	for each zGid in zohoGids
	{
		targets.add({"id": "1CPAernDPLSFJSebo5hFNQWsazLmbLbCS9TY0Kfa22SE", "gid": zGid, "label": "Zoho Ecosystem GID " + zGid, "type": "ODOO_ZOHO_21"});
	}

	for each target in targets
	{
		tId = target.get("id");
		tGid = target.get("gid");
		tLabel = target.get("label");
		tType = target.get("type");

		csvUrl = "https://docs.google.com/spreadsheets/d/" + tId + "/gviz/tq?tqx=out:csv&gid=" + tGid;

		try
		{
			resp = invokeurl
			[
				url :csvUrl
				type :GET
				detailed :true
			];
			csvText = resp.get("responseText");
			if(csvText == null || csvText == "") { csvText = resp.get("response_text"); }
			if(csvText == null || csvText == "") { csvText = "" + resp.get("response"); }

			if(csvText != "" && csvText != null)
			{
				rows = csvText.replaceAll("\r","").toList("\n");
				info "📦 [" + tLabel + "] Fetched " + rows.size() + " lines.";

				if(rows.size() > 1)
				{
					isHeader = true;
					for each row in rows
					{
						if(isHeader) { isHeader = false; continue; }
						if(row.trim() == "") { continue; }

						cols = row.replaceAll("\",\"", "###SPLIT###").toList("###SPLIT###");
						if(cols.size() >= 5)
						{
							totalProcessed = totalProcessed + 1;

							scrapDate = uploadDate;
							leadSource = "Scraper Suite";
							rawCompany = "";
							rawName = "Decision Maker";
							rawEmail = "";
							rawPhone = "";
							rawMobile = "";
							rawIndustry = "IT / Software";
							rawNotes = "";

							if(tType == "STANDARD_10")
							{
								scrapDate = if(cols.size() > 0, cols.get(0).replaceAll("\"","").trim(), uploadDate);
								leadSource = if(cols.size() > 1, cols.get(1).replaceAll("\"","").trim(), "Google Search");
								rawCompany = if(cols.size() > 2, cols.get(2).replaceAll("\"","").trim(), "");
								rawEmail = if(cols.size() > 3, cols.get(3).replaceAll("\"","").trim().toLowerCase(), "");
								rawPhone = if(cols.size() > 4, cols.get(4).replaceAll("\"","").trim(), "");
								rawIndustry = if(cols.size() > 5, cols.get(5).replaceAll("\"","").trim(), "IT / Software");
								rawName = if(cols.size() > 6, cols.get(6).replaceAll("\"","").trim(), "Business Owner");
								rawNotes = if(cols.size() > 9, cols.get(9).replaceAll("\"","").trim(), "");
							}
							else if(tType == "EXTENDED_28")
							{
								scrapDate = if(cols.size() > 0, cols.get(0).replaceAll("\"","").trim(), uploadDate);
								leadSource = if(cols.size() > 1, cols.get(1).replaceAll("\"","").trim(), "Multi-Tab Scraper");
								rawCompany = if(cols.size() > 2, cols.get(2).replaceAll("\"","").trim(), "");
								rawName = if(cols.size() > 7, cols.get(7).replaceAll("\"","").trim(), "");
								if(rawName == "" && cols.size() > 5) { rawName = cols.get(5).replaceAll("\"","").trim() + " " + cols.get(6).replaceAll("\"","").trim(); }
								rawEmail = if(cols.size() > 9, cols.get(9).replaceAll("\"","").trim().toLowerCase(), "");
								rawPhone = if(cols.size() > 10, cols.get(10).replaceAll("\"","").trim(), "");
								rawMobile = if(cols.size() > 11, cols.get(11).replaceAll("\"","").trim(), "");
								rawIndustry = if(cols.size() > 12, cols.get(12).replaceAll("\"","").trim(), "IT / Software");
								rawNotes = if(cols.size() > 22, cols.get(22).replaceAll("\"","").trim(), "");
							}
							else if(tType == "ODOO_ZOHO_21")
							{
								scrapDate = if(cols.size() > 0, cols.get(0).replaceAll("\"","").trim(), uploadDate);
								rawCompany = if(cols.size() > 1, cols.get(1).replaceAll("\"","").trim(), "");
								rawName = if(cols.size() > 3, cols.get(3).replaceAll("\"","").trim(), "");
								rawEmail = if(cols.size() > 5, cols.get(5).replaceAll("\"","").trim().toLowerCase(), "");
								rawPhone = if(cols.size() > 6, cols.get(6).replaceAll("\"","").trim(), "");
								rawIndustry = if(cols.size() > 13, cols.get(13).replaceAll("\"","").trim(), "Enterprise Software");
								leadSource = if(tId.contains("1iIcE"), "Odoo ERP Lead Generator", "Zoho Ecosystem Lead Generator");
								rawNotes = if(cols.size() > 15, cols.get(15).replaceAll("\"","").trim(), "") + " | " + if(cols.size() > 19, cols.get(19).replaceAll("\"","").trim(), "");
							}

							// Email Validation
							cleanEmail = "";
							if(rawEmail.contains("@") && rawEmail.contains(".") && !rawEmail.contains("example.com") && !rawEmail.contains("domain.com") && !rawEmail.endsWith(".png") && !rawEmail.endsWith(".jpg") && !rawEmail.endsWith(".webp") && !rawEmail.startsWith("mailto:"))
							{
								cleanEmail = rawEmail.replaceAll("mailto:", "").replaceAll("<", "").replaceAll(">", "").trim();
							}

							// Phone & Mobile Cleaning
							cleanPhone = rawPhone.replaceAll("[^0-9+ ]", "").trim();
							cleanMobile = rawMobile.replaceAll("[^0-9+ ]", "").trim();

							if(cleanPhone.startsWith("04") || cleanPhone.startsWith("+614") || cleanPhone.startsWith("614"))
							{
								if(cleanMobile == "") { cleanMobile = cleanPhone; }
								cleanPhone = "";
							}

							// MANDATORY: Must have Email AND (Phone or Mobile)
							if(cleanEmail == "" || (cleanPhone == "" && cleanMobile == ""))
							{
								totalInvalid = totalInvalid + 1;
								continue;
							}

							cleanCompany = rawCompany;
							if(cleanCompany == "" || genericTitles.contains(cleanCompany.toLowerCase()) || cleanCompany.length() < 2)
							{
								cleanCompany = "Australian Enterprise";
							}

							// Insert to Zoho CRM
							leadMap = Map();
							leadMap.put("Last_Name", if(rawName != "", rawName, "Executive"));
							leadMap.put("Company", cleanCompany);
							if(cleanEmail != "") { leadMap.put("Email", cleanEmail); }
							if(cleanPhone != "") { leadMap.put("Phone", cleanPhone); }
							if(cleanMobile != "") { leadMap.put("Mobile", cleanMobile); }
							leadMap.put("Industry", rawIndustry);
							leadMap.put("Lead_Source", leadSource);
							leadMap.put("Description", "Uploaded: " + uploadTime + " | Scraped: " + scrapDate + " | Notes: " + rawNotes);

							createRes = zoho.crm.createRecord("Leads", leadMap);
							totalImported = totalImported + 1;
						}
					}
				}
			}
		}
		catch (errCode)
		{
			info "❌ Error [" + tLabel + "]: " + errCode;
		}
	}

	info "=======================================================";
	info "🎉 ZOHO CRM DELUGE SYNC COMPLETE SUMMARY:";
	info "  - Total Records Processed : " + totalProcessed;
	info "  - Fresh Leads Uploaded    : " + totalImported;
	info "  - Duplicates Skipped      : " + totalSkipped;
	info "  - Invalid Contacts Skipped: " + totalInvalid;
	info "=======================================================";
}
