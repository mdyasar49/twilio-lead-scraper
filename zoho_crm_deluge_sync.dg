			zResp = invokeurl
			[
				url :zohoCsvUrl
				type :GET
				detailed :true
			];
			zCsvText = zResp.get("responseText");
			if(zCsvText == null || zCsvText == "") { zCsvText = zResp.get("response_text"); }
			if(zCsvText == null || zCsvText == "") { zCsvText = "" + zResp.get("response"); }

			if(zCsvText != "" && zCsvText != null)
			{
				zRows = zCsvText.replaceAll("\r","").toList("\n");
				info "📦 [Zoho Ecosystem Sheet GID " + zGid + "] Fetched " + zRows.size() + " lines.";

				if(zRows.size() > 1)
				{
					isZHeader = true;
					for each zRow in zRows
					{
						if(isZHeader) { isZHeader = false; continue; }
						if(zRow.trim() == "") { continue; }

						zCols = zRow.replaceAll("\",\"", "###SPLIT###").toList("###SPLIT###");
						if(zCols.size() >= 7)
						{
							totalProcessed = totalProcessed + 1;

							// 21-column Zoho schema: Date at 0, Company at 1, Contact at 3, Email at 5, Phone at 6
							zDate = if(zCols.size() > 0, zCols.get(0).replaceAll("\"","").trim(), uploadDate);
							zCompany = if(zCols.size() > 1, zCols.get(1).replaceAll("\"","").trim(), "");
							zName = if(zCols.size() > 3, zCols.get(3).replaceAll("\"","").trim(), "");
							zEmailRaw = if(zCols.size() > 5, zCols.get(5).replaceAll("\"","").trim().toLowerCase(), "");
							zPhoneRaw = if(zCols.size() > 6, zCols.get(6).replaceAll("\"","").trim(), "");
							zIndustry = if(zCols.size() > 13, zCols.get(13).replaceAll("\"","").trim(), "Cloud Software & CRM");
							zNotes = if(zCols.size() > 15, zCols.get(15).replaceAll("\"","").trim(), "") + " | " + if(zCols.size() > 19, zCols.get(19).replaceAll("\"","").trim(), "");

							// Email Validation
							zCleanEmail = "";
							if(zEmailRaw.contains("@") && zEmailRaw.contains(".") && !zEmailRaw.contains("example.com") && !zEmailRaw.endsWith(".png") && !zEmailRaw.endsWith(".jpg"))
							{
