							}

							zCleanCompany = zCompany;
							if(zCleanCompany == "" || genericTitles.contains(zCleanCompany.toLowerCase()))
							{
								zCleanCompany = "Australian Enterprise";
							}

							zLeadMap = Map();
							zLeadMap.put("Last_Name", if(zName != "", zName, "Executive"));
							zLeadMap.put("Company", zCleanCompany);
							if(zCleanEmail != "") { zLeadMap.put("Email", zCleanEmail); }
							if(zCleanPhone != "") { zLeadMap.put("Phone", zCleanPhone); }
							if(zCleanMobile != "") { zLeadMap.put("Mobile", zCleanMobile); }
							zLeadMap.put("Industry", zIndustry);
							zLeadMap.put("Lead_Source", "Zoho Ecosystem Lead Generator");
							zLeadMap.put("Description", "Uploaded: " + uploadTime + " | Scraped: " + zDate + " | Notes: " + zNotes);

							zCreateRes = zoho.crm.createRecord("Leads", zLeadMap);
							totalImported = totalImported + 1;
						}
					}
				}
			}
		}
		catch (errCode)
		{
			info "❌ Error Zoho Sheet GID " + zGid + ": " + errCode;
		}
	}

	info "=======================================================";
	info "🎉 ZOHO CRM DELUGE SYNC COMPLETE SUMMARY:";
	info "  - Total Records Processed : " + totalProcessed;
	info "  - Fresh Leads Uploaded    : " + totalImported;
	info "  - Duplicates Skipped      : " + totalSkipped;
	info "  - Invalid Contacts Skipped: " + totalInvalid;
	info "=======================================================";
}
